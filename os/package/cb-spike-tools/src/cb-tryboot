#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
#
# Boots the other slot once. With the os_prefix layout, tryboot.txt is first
# pointed at the other slot (a raw single-byte write, like cb-commit); with
# the autoboot layout, autoboot.txt already names the tryboot partition.

set -eu

arg() { tr ' ' '\n' < /proc/cmdline | sed -n "s/^$1=//p"; }
die() { echo "cb-tryboot: $*" >&2; exit 1; }
char_at() { dd if="$1" bs=1 skip="$2" count=1 2>/dev/null; }

slot="$(arg cb.slot)"
layout="$(arg cb.layout)"
other=a
[ "$slot" = a ] && other=b

case "$layout" in
  osprefix)
    file=/boot/tryboot.txt
    umount /boot 2>/dev/null || true
    mount -t vfat -o ro /dev/mmcblk0p1 /boot
    off="$(cb-slot-offsets "$file" 'os_prefix=slot-')" || die "no os_prefix line in $file"
    case "$(char_at "$file" "$off")" in a|b) ;; *) die "byte $off of $file is not a slot" ;; esac
    cb-rawpatch /dev/mmcblk0p1 "$file" "$off" "$other"
    umount /boot
    ;;
  autoboot) ;;
  *) die "layout '$layout' has no second slot" ;;
esac

echo "CB_TRYBOOT from=$slot to=$other"
exec /usr/sbin/cb-tryboot-reboot
