#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
#
# Lab networking for the spike image: joins the Wi-Fi configured at build
# time and prints CB_NET_UP with the address. Runs in the background after
# the boot marker, so it never affects boot-time measurements.

[ -r /etc/wpa_supplicant.conf ] || exit 0

(
  modprobe brcmfmac || exit 1
  i=0
  while [ ! -d /sys/class/net/wlan0 ] && [ $i -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
  wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf > /dev/null || exit 1
  udhcpc -i wlan0 -t 20 -T 2 -A 5 -b -q -s /usr/share/udhcpc/default.script > /dev/null 2>&1
  i=0
  while [ $i -lt 600 ]; do
    ip="$(ip -4 -o addr show wlan0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)"
    if [ -n "$ip" ]; then
      echo "CB_NET_UP ip=$ip"
      exit 0
    fi
    sleep 0.5
    i=$((i + 1))
  done
  echo "CB_NET_FAILED"
) < /dev/null &
