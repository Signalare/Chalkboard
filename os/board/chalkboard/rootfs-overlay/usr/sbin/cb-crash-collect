#!/bin/sh
# SPDX-License-Identifier: MIT OR Apache-2.0
#
# Harvests pstore/ramoops panic and crash dumps to /data/crashes/ (OS-008, STO-010).
# Strictly maintains at most 20 reports, pruning oldest when exceeded.

set -eu

PSTORE_DIR="/sys/fs/pstore"
CRASH_DIR="/data/crashes"
MAX_REPORTS=20

# 1. Ensure /data is mounted before harvesting
if ! mountpoint -q /data 2>/dev/null; then
  echo "cb-crash-collect: /data is not mounted. Skipping crash collection."
  exit 0
fi

# 2. Ensure pstore filesystem is mounted
if [ -d "$PSTORE_DIR" ] && ! mountpoint -q "$PSTORE_DIR" 2>/dev/null; then
  mount -t pstore pstore "$PSTORE_DIR" 2>/dev/null || true
fi

if [ ! -d "$PSTORE_DIR" ]; then
  exit 0
fi

mkdir -p "$CRASH_DIR"

# 3. Check for crash files in pstore
found_files=""
for f in "$PSTORE_DIR"/dmesg-* "$PSTORE_DIR"/console-* "$PSTORE_DIR"/pmsg-*; do
  if [ -f "$f" ]; then
    found_files="$found_files $f"
  fi
done

if [ -z "$found_files" ]; then
  # No crash files to collect
  exit 0
fi

echo "cb-crash-collect: Found crash artifacts in pstore."

timestamp="$(date -u +"%Y%m%d_%H%M%S" 2>/dev/null || date +"%s")"
report_file="${CRASH_DIR}/crash_${timestamp}.txt"

{
  echo "================================================================================"
  echo "Chalkboard Crash Report: ${timestamp}"
  echo "Captured from pstore/ramoops (OS-008)"
  echo "================================================================================"
  echo ""
  for f in $found_files; do
    if [ -f "$f" ]; then
      echo "--- File: $(basename "$f") ---"
      cat "$f"
      echo ""
      # Remove from pstore so it is not re-harvested on subsequent boots
      rm -f "$f"
    fi
  done
} > "$report_file"

echo "cb-crash-collect: Saved crash report to $report_file"

# 4. Prune older crash reports to enforce max 20 reports (OS-008)
prune_old_reports() {
  local dir="$1"
  local max="$2"

  total=$(ls -1 "$dir"/crash_*.txt 2>/dev/null | wc -l)
  if [ "$total" -gt "$max" ]; then
    excess=$(( total - max ))
    echo "cb-crash-collect: Pruning $excess old crash report(s) to enforce limit of $max."

    # Sort oldest first by mtime (ls -tr) and remove excess
    ls -1tr "$dir"/crash_*.txt 2>/dev/null | head -n "$excess" | while IFS= read -r old_file; do
      if [ -n "$old_file" ] && [ -f "$old_file" ]; then
        rm -f "$old_file"
      fi
    done
  fi
}

prune_old_reports "$CRASH_DIR" "$MAX_REPORTS"
