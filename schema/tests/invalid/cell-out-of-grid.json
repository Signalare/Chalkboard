{
  "schemaVersion": 1,
  "id": "test",
  "name": "Test",
  "canvas": {
    "width": 1920,
    "height": 1080
  },
  "styles": {
    "heading": {
      "font": "Oswald",
      "size": 40
    },
    "body": {
      "font": "Inter",
      "size": 30
    }
  },
  "root": {
    "type": "repeater",
    "source": "items",
    "capacity": 4,
    "template": {
      "type": "container",
      "children": [
        {
          "type": "text",
          "style": "body",
          "text": "{{item.name}}",
          "fit": {
            "mode": "clip"
          },
          "cell": {
            "column": 0,
            "row": 0
          }
        },
        {
          "type": "price",
          "style": "body",
          "value": "item.price",
          "minSize": 20,
          "cell": {
            "column": 2,
            "row": 0
          }
        }
      ],
      "layout": {
        "type": "grid",
        "columns": [
          "1fr",
          "1fr"
        ],
        "rows": [
          "content"
        ]
      }
    }
  }
}
