{
  "$schema": "../template.v1.json",
  "schemaVersion": 1,
  "id": "highlight",
  "name": "Single-item highlight",
  "description": "One item filling a portrait screen: large photo, name, description and price.",
  "canvas": { "width": 1080, "height": 1920, "background": "#1b1b1f" },
  "styles": {
    "page": { "padding": [80, 72] },
    "name": { "font": "Playfair Display", "size": 112, "weight": 700, "color": "#ffffff", "align": "center" },
    "description": { "font": "Inter", "size": 40, "color": "#c9c9d1", "align": "center", "lineHeight": 1.3 },
    "price": { "font": "Oswald", "size": 160, "weight": 600, "color": "#ffcf5c", "align": "center" },
    "soldOutBadge": { "font": "Oswald", "size": 64, "weight": 700, "color": "#1b1b1f", "background": "#ffcf5c", "padding": [12, 32], "radius": 12 }
  },
  "soldOut": { "mode": "badge", "badgeText": "Slutsåld", "badgeStyle": "soldOutBadge" },
  "root": {
    "type": "repeater",
    "style": "page",
    "width": "fill",
    "height": "fill",
    "source": "items",
    "capacity": 1,
    "layout": { "type": "flex", "direction": "column" },
    "template": {
      "type": "container",
      "width": "fill",
      "height": "fill",
      "layout": { "type": "flex", "direction": "column", "gap": 48, "align": "center", "justify": "center" },
      "children": [
        {
          "type": "conditional",
          "when": { "hasImage": true },
          "then": { "type": "image", "src": "{{item.image}}", "width": 936, "height": 936, "scale": "cover" }
        },
        { "type": "text", "style": "name", "text": "{{item.name}}", "width": "fill", "fit": { "mode": "shrink", "minSize": 64 } },
        {
          "type": "conditional",
          "when": { "hasDescription": true },
          "then": { "type": "text", "style": "description", "text": "{{item.description | truncate:180}}", "width": "fill", "fit": { "mode": "wrap", "maxLines": 4 } }
        },
        { "type": "price", "style": "price", "value": "item.price", "minSize": 96 }
      ]
    }
  }
}
